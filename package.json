{
  "name": "little-bible",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "postinstall": "prisma generate",
    "cf:preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "cf:deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf:typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "d1:migrate:local": "wrangler d1 migrations apply little-bible-db --local",
    "d1:migrate:remote": "wrangler d1 migrations apply little-bible-db --remote"
  },
  "dependencies": {
    "@apple/app-store-server-library": "^3.1.0",
    "@auth/prisma-adapter": "^2.11.2",
    "@opennextjs/cloudflare": "^1.9.2",
    "@prisma/adapter-d1": "^7.8.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@tailwindcss/postcss": "^4",
    "dotenv": "^17.4.2",
    "googleapis": "^174.0.0",
    "next": "15.5.19",
    "next-auth": "^5.0.0-beta.31",
    "pg": "^8.21.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "stripe": "^22.2.0",
    "tailwindcss": "^4"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "prisma": "^7.8.0",
    "typescript": "^5",
    "wrangler": "^4.42.0"
  }
}
