generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

// Cloudflare D1 (SQLite). Runtime connection is supplied by the
// @prisma/adapter-d1 driver adapter (see lib/prisma.ts); the CLI uses a
// local file url from prisma.config.ts only for `migrate diff`/`studio`.
datasource db {
  provider = "sqlite"
}

// NOTE: SQLite/D1 has no native enums. AdminRole is stored as a String.
// Allowed values: SUPER_ADMIN | CONTENT_EDITOR | THEOLOGICAL_REVIEWER
//                 CURRICULUM_MANAGER | SUPPORT_ADMIN | ANALYTICS_VIEWER
// Validation is enforced in application code (see lib/admin/roles.ts).

// ── NextAuth required tables ─────────────────────────────────────────────────

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String     @id @default(cuid())
  name          String?
  email         String?    @unique
  emailVerified DateTime?
  image         String?
  createdAt     DateTime   @default(now())
  role          String?    // AdminRole enum value (see note above); null = regular user
  accounts      Account[]
  sessions      Session[]
  progress      UserProgress?
  donations     Donation[]
  family        Family?
  auditLogs     AdminAuditLog[]
  appInterest   AppInterest?
  activityRecords      ActivityRecord[]
  memoryVerseProgress  MemoryVerseProgress[]
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ── App data ─────────────────────────────────────────────────────────────────

model UserProgress {
  id                   String   @id @default(cuid())
  userId               String   @unique
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  wisdomSeeds          Int      @default(0)
  streak               Int      @default(0)
  lastActiveDate       String   @default("")
  completedVersesJson  String   @default("{}")
  completedChapters    String   @default("[]") // JSON array of chapter refs (was String[])
  badgesJson           String   @default("[]")
  sessionsJson         String   @default("[]")
  updatedAt            DateTime @updatedAt
}

// ── Family Identity System ────────────────────────────────────────────────────

model Family {
  id         String   @id @default(cuid())
  name       String?
  ownerId    String   @unique
  owner      User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  members    FamilyMember[]
  streak     FamilyStreak?
  prayers    FamilyPrayer[]
  milestones FamilyMilestone[]
  journeyId  String?
  createdAt  DateTime @default(now())
}

model FamilyMember {
  id          String   @id @default(cuid())
  familyId    String
  family      Family   @relation(fields: [familyId], references: [id], onDelete: Cascade)
  name        String
  age         Int?
  avatarId    String   @default("lion")
  accentColor String?
  faithGoals  String   @default("[]") // JSON array of goals (was String[])
  seeds       Int      @default(0)
  sortOrder   Int      @default(0)
  progress    MemberProgress?
  sessions    MemberSession[]
  activityRecords      ActivityRecord[]
  memoryVerseProgress  MemoryVerseProgress[]
  createdAt   DateTime @default(now())
}

model MemberProgress {
  id                  String   @id @default(cuid())
  memberId            String   @unique
  member              FamilyMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  completedVersesJson String   @default("{}")
  completedChapters   String   @default("[]") // JSON array of chapter refs (was String[])
  memoryVersesJson    String   @default("[]")
  lastReadBook        String?
  lastReadChapter     Int?
  lastReadAt          DateTime?
  updatedAt           DateTime @updatedAt
}

model MemberSession {
  id       String   @id @default(cuid())
  memberId String
  member   FamilyMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  bookSlug String
  chapter  Int
  verse    Int
  mode     String
  readAt   DateTime @default(now())
}

model FamilyStreak {
  id            String   @id @default(cuid())
  familyId      String   @unique
  family        Family   @relation(fields: [familyId], references: [id], onDelete: Cascade)
  currentStreak Int      @default(0)
  longestStreak Int      @default(0)
  lastReadDate  String   @default("")
  updatedAt     DateTime @updatedAt
}

model FamilyPrayer {
  id         String   @id @default(cuid())
  familyId   String
  family     Family   @relation(fields: [familyId], references: [id], onDelete: Cascade)
  memberId   String?
  bookSlug   String
  chapter    Int
  verse      Int
  prayerText String
  answered   Boolean  @default(false)
  savedAt    DateTime @default(now())
}

model FamilyMilestone {
  id         String   @id @default(cuid())
  familyId   String
  family     Family   @relation(fields: [familyId], references: [id], onDelete: Cascade)
  memberId   String?
  type       String
  achievedAt DateTime @default(now())
}

// ── Donations ─────────────────────────────────────────────────────────────────

model Donation {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  amount     Int      // in smallest unit (cents / kobo)
  currency   String   // 'usd' | 'ngn'
  provider   String   // 'stripe' | 'paystack'
  status     String   @default("pending") // 'pending' | 'completed' | 'failed'
  reference  String?  @unique
  createdAt  DateTime @default(now())
}

// ── Admin ─────────────────────────────────────────────────────────────────────

model AnalyticsEvent {
  id        String   @id @default(cuid())
  event     String
  userId    String?
  isGuest   Boolean  @default(false)
  bookSlug  String?
  chapter   Int?
  verseNum  Int?
  storyId   String?
  mode      String?
  props     String?  // JSON object (was Json?)
  createdAt DateTime @default(now())

  @@index([event, createdAt])
  @@index([userId, createdAt])
  @@index([bookSlug, chapter])
  @@index([createdAt])
}

model ContentReview {
  id         String   @id @default(cuid())
  bookSlug   String
  chapter    Int
  verseNum   Int?
  status     String   @default("pending") // pending | approved | needs_revision | flagged
  concern    String?  // theological | too_difficult | language | other
  notes      String?
  reviewerId String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([bookSlug, chapter, verseNum])
  @@index([status])
  @@index([bookSlug, chapter])
}

model AdminAuditLog {
  id        String   @id @default(cuid())
  adminId   String
  admin     User     @relation(fields: [adminId], references: [id])
  action    String
  targetId  String?
  details   String?  // JSON object (was Json?)
  createdAt DateTime @default(now())

  @@index([adminId, createdAt])
  @@index([createdAt])
}

// ── Mobile App Interest ───────────────────────────────────────────────────────

model AppInterest {
  id              String    @id @default(cuid())
  userId          String    @unique
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  wantsIos        Boolean   @default(false)
  wantsAndroid    Boolean   @default(false)
  wantsPush       Boolean   @default(true)
  wantsEmail      Boolean   @default(true)
  countryCode     String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  notifiedIos     DateTime?
  notifiedAndroid DateTime?

  @@index([wantsIos])
  @@index([wantsAndroid])
  @@index([createdAt])
}

// ── Engagement & Activity System ──────────────────────────────────────────────

model ActivityRecord {
  id           String   @id @default(cuid())
  userId       String?
  memberId     String?
  storyId      String
  activityType String   // 'memory-builder' | 'story-sequence' | 'character-match' | 'application'
  score        Int      @default(0)
  perfect      Boolean  @default(false)
  seedsEarned  Int      @default(0)
  attempts     Int      @default(1)
  createdAt    DateTime @default(now())

  user   User?         @relation(fields: [userId],   references: [id], onDelete: SetNull)
  member FamilyMember? @relation(fields: [memberId], references: [id], onDelete: SetNull)

  @@index([storyId])
  @@index([userId])
  @@index([memberId])
  @@index([createdAt])
}

model MemoryVerseProgress {
  id            String    @id @default(cuid())
  userId        String?
  memberId      String?
  verseRef      String
  stage         String    @default("learning") // 'learning' | 'practicing' | 'mastered'
  attempts      Int       @default(0)
  lastPracticed DateTime?
  masteredAt    DateTime?
  seedsEarned   Int       @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user   User?         @relation(fields: [userId],   references: [id], onDelete: SetNull)
  member FamilyMember? @relation(fields: [memberId], references: [id], onDelete: SetNull)

  @@unique([userId, verseRef])
  @@unique([memberId, verseRef])
  @@index([verseRef])
}
