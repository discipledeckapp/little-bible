generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

// Cloudflare D1 (SQLite). Runtime connection is supplied by the
// @prisma/adapter-d1 driver adapter (see lib/prisma.ts); the CLI uses a
// local file url from prisma.config.ts only for `migrate diff`/`studio`.
datasource db {
  provider = "sqlite"
}

// NOTE: SQLite/D1 has no native enums. AdminRole is stored as a String.
// Allowed values: SUPER_ADMIN | CONTENT_EDITOR | THEOLOGICAL_REVIEWER
//                 CURRICULUM_MANAGER | SUPPORT_ADMIN | ANALYTICS_VIEWER
// Validation is enforced in application code (see lib/admin/roles.ts).

// ── NextAuth required tables ─────────────────────────────────────────────────

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id                  String                @id @default(cuid())
  name                String?
  email               String?               @unique
  emailVerified       DateTime?
  image               String?
  createdAt           DateTime              @default(now())
  role                String? // AdminRole enum value (see note above); null = regular user
  accounts            Account[]
  sessions            Session[]
  progress            UserProgress?
  donations           Donation[]
  family              Family?
  auditLogs           AdminAuditLog[]
  appInterest         AppInterest?
  activityRecords     ActivityRecord[]
  memoryVerseProgress MemoryVerseProgress[]
  analyticsEvents     AnalyticsEvent[]
  mobileProgress      MobileProgress[]
  mobileEntitlements  MobileEntitlement[]
  wantsEmailDigest    Boolean               @default(false)
  wantsNotifications  Boolean               @default(false)
  cloudSyncEnabled    Boolean               @default(false)
  consentedAt         DateTime?

  // Content authoring & review (US-19 / US-20)
  contentPackages   ContentPackage[]  @relation("ContentPackageAuthor")
  contentVersions   ContentVersion[]  @relation("ContentVersionAuthor")
  contentApprovals  ContentApproval[] @relation("ContentApprovalReviewer")
  lbvVersesAuthored LbvVerseDraft[]   @relation("LbvVerseAuthor")
  lbvVersesReviewed LbvVerseDraft[]   @relation("LbvVerseReviewer")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ── App data ─────────────────────────────────────────────────────────────────

model UserProgress {
  id                  String   @id @default(cuid())
  userId              String   @unique
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  wisdomSeeds         Int      @default(0)
  streak              Int      @default(0)
  lastActiveDate      String   @default("")
  completedVersesJson String   @default("{}")
  completedChapters   String   @default("[]") // JSON array of chapter refs (was String[])
  badgesJson          String   @default("[]")
  sessionsJson        String   @default("[]")
  updatedAt           DateTime @updatedAt
}

// ── Family Identity System ────────────────────────────────────────────────────

model Family {
  id         String            @id @default(cuid())
  name       String?
  ownerId    String            @unique
  owner      User              @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  members    FamilyMember[]
  streak     FamilyStreak?
  prayers    FamilyPrayer[]
  milestones FamilyMilestone[]
  journeyId  String?
  createdAt  DateTime          @default(now())
}

model FamilyMember {
  id                  String                @id @default(cuid())
  familyId            String
  family              Family                @relation(fields: [familyId], references: [id], onDelete: Cascade)
  name                String
  age                 Int?
  avatarId            String                @default("lion")
  accentColor         String?
  faithGoals          String                @default("[]") // JSON array of goals (was String[])
  seeds               Int                   @default(0)
  sortOrder           Int                   @default(0)
  progress            MemberProgress?
  sessions            MemberSession[]
  activityRecords     ActivityRecord[]
  memoryVerseProgress MemoryVerseProgress[]
  createdAt           DateTime              @default(now())
}

model MemberProgress {
  id                  String       @id @default(cuid())
  memberId            String       @unique
  member              FamilyMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  completedVersesJson String       @default("{}")
  completedChapters   String       @default("[]") // JSON array of chapter refs (was String[])
  memoryVersesJson    String       @default("[]")
  lastReadBook        String?
  lastReadChapter     Int?
  lastReadAt          DateTime?
  updatedAt           DateTime     @updatedAt
}

model MemberSession {
  id       String       @id @default(cuid())
  memberId String
  member   FamilyMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  bookSlug String
  chapter  Int
  verse    Int
  mode     String
  readAt   DateTime     @default(now())
}

model FamilyStreak {
  id            String   @id @default(cuid())
  familyId      String   @unique
  family        Family   @relation(fields: [familyId], references: [id], onDelete: Cascade)
  currentStreak Int      @default(0)
  longestStreak Int      @default(0)
  lastReadDate  String   @default("")
  updatedAt     DateTime @updatedAt
}

model FamilyPrayer {
  id         String   @id @default(cuid())
  familyId   String
  family     Family   @relation(fields: [familyId], references: [id], onDelete: Cascade)
  memberId   String?
  bookSlug   String
  chapter    Int
  verse      Int
  prayerText String
  answered   Boolean  @default(false)
  savedAt    DateTime @default(now())
}

model FamilyMilestone {
  id         String   @id @default(cuid())
  familyId   String
  family     Family   @relation(fields: [familyId], references: [id], onDelete: Cascade)
  memberId   String?
  type       String
  achievedAt DateTime @default(now())
}

// ── Donations ─────────────────────────────────────────────────────────────────

model Donation {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  amount    Int // in smallest unit (cents / kobo)
  currency  String // 'usd' | 'ngn'
  provider  String // 'stripe' | 'paystack'
  status    String   @default("pending") // 'pending' | 'completed' | 'failed'
  reference String?  @unique
  createdAt DateTime @default(now())
}

// ── Admin ─────────────────────────────────────────────────────────────────────

model AnalyticsEvent {
  id        String   @id @default(cuid())
  event     String
  userId    String?
  isGuest   Boolean  @default(false)
  bookSlug  String?
  chapter   Int?
  verseNum  Int?
  storyId   String?
  mode      String?
  props     String? // JSON object (was Json?)
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([event, createdAt])
  @@index([userId, createdAt])
  @@index([bookSlug, chapter])
  @@index([createdAt])
}

/// Privacy-minimised mobile progress. profileId is a random app identifier;
/// nickname, drawings, free text and exact birth dates are never uploaded.
/// Progress records from the mobile app.
///
/// Entries arriving via a session cookie carry `userId`; entries arriving via
/// the device-token Bearer scheme carry `deviceId` (the app's secure-storage
/// UUID) and leave `userId` null. This mirrors the design of MobileEntitlement.
model MobileProgress {
  id         String   @id @default(cuid())
  userId     String?
  deviceId   String?
  profileId  String
  operation  String
  payload    String
  clientId   String
  createdAt  DateTime
  receivedAt DateTime @default(now())
  user       User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, clientId])
  @@unique([deviceId, clientId])
  @@index([userId, profileId, receivedAt])
  @@index([deviceId, profileId, receivedAt])
}

/// A validated store purchase.
///
/// `userId` is OPTIONAL: the mobile app has no login, so most entitlements
/// arrive with no user attached and are identified by `deviceId` instead. The
/// store-signed receipt is what authenticates the request, and `transactionId`
/// is the real idempotency key — it is the only uniqueness constraint that can
/// be relied on. (There used to be a `@@unique([userId, productId])`, which
/// silently assumed every purchase had a user.)
model MobileEntitlement {
  id            String    @id @default(cuid())
  userId        String?
  deviceId      String?
  productId     String
  platform      String
  transactionId String    @unique
  status        String    @default("active")
  verifiedAt    DateTime  @default(now())
  revokedAt     DateTime?
  user          User?     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([deviceId])
}

model ContentReview {
  id         String   @id @default(cuid())
  bookSlug   String
  chapter    Int
  verseNum   Int?
  status     String   @default("pending") // pending | approved | needs_revision | flagged
  concern    String? // theological | too_difficult | language | other
  notes      String?
  reviewerId String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([bookSlug, chapter, verseNum])
  @@index([status])
  @@index([bookSlug, chapter])
}

model AdminAuditLog {
  id        String   @id @default(cuid())
  adminId   String
  admin     User     @relation(fields: [adminId], references: [id])
  action    String
  targetId  String?
  details   String? // JSON object (was Json?)
  createdAt DateTime @default(now())

  @@index([adminId, createdAt])
  @@index([createdAt])
}

// ── Mobile App Interest ───────────────────────────────────────────────────────

model AppInterest {
  id              String    @id @default(cuid())
  userId          String    @unique
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  wantsIos        Boolean   @default(false)
  wantsAndroid    Boolean   @default(false)
  wantsPush       Boolean   @default(true)
  wantsEmail      Boolean   @default(true)
  countryCode     String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  notifiedIos     DateTime?
  notifiedAndroid DateTime?

  @@index([wantsIos])
  @@index([wantsAndroid])
  @@index([createdAt])
}

// ── Engagement & Activity System ──────────────────────────────────────────────

model ActivityRecord {
  id           String   @id @default(cuid())
  userId       String?
  memberId     String?
  storyId      String
  activityType String // 'memory-builder' | 'story-sequence' | 'character-match' | 'application'
  score        Int      @default(0)
  perfect      Boolean  @default(false)
  seedsEarned  Int      @default(0)
  attempts     Int      @default(1)
  createdAt    DateTime @default(now())

  user   User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  member FamilyMember? @relation(fields: [memberId], references: [id], onDelete: SetNull)

  @@index([storyId])
  @@index([userId])
  @@index([memberId])
  @@index([createdAt])
}

model MemoryVerseProgress {
  id            String    @id @default(cuid())
  userId        String?
  memberId      String?
  verseRef      String
  stage         String    @default("learning") // 'learning' | 'practicing' | 'mastered'
  attempts      Int       @default(0)
  lastPracticed DateTime?
  masteredAt    DateTime?
  seedsEarned   Int       @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user   User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  member FamilyMember? @relation(fields: [memberId], references: [id], onDelete: SetNull)

  @@unique([userId, verseRef])
  @@unique([memberId, verseRef])
  @@index([verseRef])
}

// ── Content authoring & review workflow (US-19 / US-20) ──────────────────────
//
// A content package is never edited in place. Every save produces a new
// ContentVersion holding the whole package body, so the review trail, the
// published bytes and the rollback target are all the same object. Publication
// requires recorded approvals from three distinct reviewers, none of whom may be
// the version's author (see lib/content/review-workflow.ts).

model ContentPackage {
  id                  String  @id // story id, e.g. "the-lost-son"
  kind                String  @default("stories") // stories | activities
  title               String
  genre               String // narrative | wisdom | lament | teaching | parable | poetry
  sensitivityTier     String // general | guided | parental_presence
  ageBand             String  @default("emerging") // early | emerging | independent
  learningObjective   String
  originalContext     String
  canonicalConnection String
  disputedDoctrines   String? // free text; null = none flagged
  status              String  @default("draft") // draft | in_review | approved | published | archived

  createdById        String
  createdBy          User    @relation("ContentPackageAuthor", fields: [createdById], references: [id])
  publishedVersionId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  versions ContentVersion[]

  @@index([status])
  @@index([kind, status])
}

model ContentVersion {
  id            String         @id @default(cuid())
  packageId     String
  package       ContentPackage @relation(fields: [packageId], references: [id], onDelete: Cascade)
  versionNumber Int
  /// The complete package payload as published to R2. JSON string (D1 has no JSON type).
  body          String
  /// Matches the R2 key's content hash, so a version maps to exactly one object.
  contentHash   String
  changeNote    String?
  status        String         @default("in_review") // in_review | approved | rejected | published | superseded

  authorId String
  author   User   @relation("ContentVersionAuthor", fields: [authorId], references: [id])

  r2Key       String?
  createdAt   DateTime  @default(now())
  publishedAt DateTime?

  approvals ContentApproval[]

  @@unique([packageId, versionNumber])
  @@index([status])
  @@index([packageId, createdAt])
}

model ContentApproval {
  id        String         @id @default(cuid())
  versionId String
  version   ContentVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)

  /// theological | christian_education | safeguarding
  reviewKind String
  reviewerId String
  reviewer   User   @relation("ContentApprovalReviewer", fields: [reviewerId], references: [id])

  /// approved | revision_requested
  decision String
  /// Required in both directions — an approval with no comment is not a review.
  comment  String

  createdAt DateTime @default(now())

  /// One decision per review kind per version; re-reviewing replaces the row.
  @@unique([versionId, reviewKind])
  @@index([reviewerId])
}

model LbvVerseDraft {
  id       String @id @default(cuid())
  bookSlug String
  chapter  Int
  verseNum Int

  /// Source text, never edited (Translation Charter §1.1).
  kjv String
  /// Read-only modern reference shown beside the adaptation.
  web String @default("")
  /// The Little Bible adaptation being authored.
  lbv String

  status String @default("draft") // draft | in_review | published

  authorId      String
  author        User    @relation("LbvVerseAuthor", fields: [authorId], references: [id])
  reviewerId    String?
  reviewer      User?   @relation("LbvVerseReviewer", fields: [reviewerId], references: [id])
  reviewComment String?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  publishedAt DateTime?

  @@unique([bookSlug, chapter, verseNum])
  @@index([status])
}

/// Published LBV verses served to the mobile app's verse resolution chain.
/// `source` distinguishes an adaptation from the bundled public-domain text.
model AdaptedVerse {
  id       String @id @default(cuid())
  bookSlug String
  chapter  Int
  verseNum Int

  text      String
  source    String  @default("little-bible")
  isAdapted Boolean @default(true)

  publishedAt DateTime @default(now())
  draftId     String?

  @@unique([bookSlug, chapter, verseNum])
  @@index([bookSlug, chapter])
}
